# asset-nest 環境設定範例：複製為 .env（後端 dotenvy 會讀取專案根目錄的 .env）

# 後端綁定位址（預設 0.0.0.0:8080）
# BIND_ADDR=0.0.0.0:8080

# SQLite 資料庫（預設 sqlite://asset-nest.db；檔案會自動建立）
# DATABASE_URL=sqlite://asset-nest.db

# 前端建置產物目錄（預設 frontend/dist/spa）
# WEB_DIST_DIR=frontend/dist/spa

# 前端 API 位址覆寫（預設空＝使用相對路徑 /api）
# 注意：Vite 只會讀取 frontend/ 目錄下的 .env 或行程環境變數
# VITE_API_BASE_URL=

# --- Kea 整合（見 docs/adr/0010；連線測試：pnpm test:kea）---
# Kea 3 內建 HTTP 控制通道位址；未設定時無法連線 Kea
# KEA_API_URL=http://1192.168.0.2:8000

# 控制通道 Basic 認證（Kea 啟用 authentication 時必填；留空則不帶認證）
# KEA_API_USERNAME=
# KEA_API_PASSWORD=

# --- IP 觀測（見 docs/adr/0014~0016；僅本機同 L2 的 IPv4 網段可觀測）---
# ARP 探測模式：
#   auto（預設）：先 raw，遇權限問題或環境不可用時降級並記錄一次警告
#   raw：Linux AF_PACKET（systemd 單元已帶 CAP_NET_RAW）
#   unprivileged：零權限（UDP 觸發 kernel ARP 解析後讀 /proc/net/arp）
# OBSERVATION_PROBE_MODE=auto

# 事件保留天數（預設 365，須為正整數）：期滿事件每日自動清理，不影響現況
# OBSERVATION_RETENTION_DAYS=365
