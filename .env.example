# asset-nest 環境設定範例：複製為 .env（後端 dotenvy 會讀取專案根目錄的 .env）

# 後端綁定位址（預設 0.0.0.0:8080）
# BIND_ADDR=0.0.0.0:8080

# SQLite 資料庫（預設 sqlite://asset-nest.db；檔案會自動建立）
# DATABASE_URL=sqlite://asset-nest.db

# 前端建置產物目錄（預設 frontend/dist/spa）
# WEB_DIST_DIR=frontend/dist/spa

# 前端 API 位址覆寫（預設空＝使用相對路徑 /api）
# 注意：Vite 只會讀取 frontend/ 目錄下的 .env 或行程環境變數
# VITE_API_BASE_URL=

# --- 登入（見 docs/adr/0021）---
# 單一帳號登入；未設定或（trim 後）空白時，帳號與密碼各自套用預設 admin。
# 一鍵安裝會寫入帳號 admin、隨機產生密碼（見 deploy/install.sh）。
# 任一欄位變更即所有裝置的工作階段立即失效（須重新登入）。
# 工作階段自登入起固定 30 天，不隨活動續期。
# 密碼為明文存放；一鍵安裝產生的環境檔為 root 所有、權限 0640。
# AUTH_USERNAME=admin
# AUTH_PASSWORD=admin

# --- Kea 整合（見 docs/adr/0010；連線測試：pnpm test:kea）---
# Kea 3 內建 HTTP 控制通道位址；未設定時無法連線 Kea
# KEA_API_URL=http://1192.168.0.2:8000

# 控制通道 Basic 認證（Kea 啟用 authentication 時必填；留空則不帶認證）
# KEA_API_USERNAME=
# KEA_API_PASSWORD=

# --- IP 觀測與觀測代理（見 docs/adr/0018、docs/adr/0019）---
# 觀測由代理執行（安裝與行為見 README「觀測代理」）；後端只保留 Kea 租約
# 觀測、入庫與呈現。以下為後端變數：
#
# 代理入庫認證碼：安裝後端時隨機產生，代理設定同一組；未設定（或留空）時
# 代理入庫端點一律回 503。輪替＝改後端與所有代理並重啟兩端。
# AGENT_AUTH_CODE=
#
# 代理「在線」門檻秒數（預設 900，須為正整數）：
# 最後回報距今不超過此秒數視為在線，否則標「離線」
# AGENT_STALE_SECS=900
#
# 被拒回報保留天數（預設 30，須為正整數）：認證碼不符的來源記錄，
# 期滿每日自動清理
# AGENT_AUTH_FAILURE_RETENTION_DAYS=30
#
# 事件保留天數（預設 365，須為正整數）：期滿事件每日自動清理，不影響現況
# OBSERVATION_RETENTION_DAYS=365
